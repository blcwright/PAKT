    },
    {
      "type": "range",
      "id": "star_count",
      "label": "Stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "Set to 0 to hide."
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#d8a13a"
    },
    {
      "type": "header",
      "content": "Headline"
    },
